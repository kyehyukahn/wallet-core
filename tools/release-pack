#!/bin/bash
#
# Package the built native artifacts into a release directory ready for
# `gh release create` upload.
#
# Usage:
#   tools/release-pack <version>      # e.g. tools/release-pack 0.2.0
#
# Prerequisites (all built ahead of time):
#   - build/ios-frameworks/WalletCoreCommon.xcframework            (tools/ios-build)
#   - swift/WalletCoreRs.xcframework                                (tools/generate-files ios)
#   - build/wallet-core.aar                                         (tools/android-build)
#   - android/wallet-core-proto/build/libs/wallet-core-proto.jar    (./gradlew :wallet-core-proto:jar, from v0.2.0)
#   - swift/Sources/                                                (codegen output, always present)
#
# Output:
#   build/release-v<version>/
#     ├── WalletCoreCommon.xcframework.zip
#     ├── WalletCoreRs.xcframework.zip
#     ├── wallet-core.aar
#     ├── wallet-core-proto.jar          (v0.2.0+: Java protobuf-generated SigningInput types)
#     ├── swift-sources.tar.gz           (v0.2.0+: Swift protobuf + wrapper sources for podspec source_files)
#     └── SHA256SUMS

set -e

VERSION=$1
if [[ -z "$VERSION" ]]; then
    echo "usage: $0 <version>   (e.g. $0 0.2.0)" >&2
    exit 1
fi

OUT="build/release-v${VERSION}"
COMMON_XCF="build/ios-frameworks/WalletCoreCommon.xcframework"
RS_XCF="swift/WalletCoreRs.xcframework"
AAR="build/wallet-core.aar"
PROTO_JAR="android/wallet-core-proto/build/libs/wallet-core-proto.jar"
SWIFT_SRC_DIR="swift/Sources"

for src in "$COMMON_XCF" "$RS_XCF" "$AAR" "$PROTO_JAR" "$SWIFT_SRC_DIR"; do
    if [[ ! -e "$src" ]]; then
        echo "ERROR: required input missing: $src" >&2
        echo "Run the platform builds first (tools/generate-files ios, tools/ios-build," >&2
        echo "tools/android-build, ./gradlew :wallet-core-proto:jar)." >&2
        exit 2
    fi
done

rm -rf "$OUT"
mkdir -p "$OUT"

echo "Packaging iOS xcframeworks (ditto)..."
ditto -c -k --sequesterRsrc --keepParent "$COMMON_XCF" "$OUT/WalletCoreCommon.xcframework.zip"
ditto -c -k --sequesterRsrc --keepParent "$RS_XCF"     "$OUT/WalletCoreRs.xcframework.zip"

echo "Copying Android AAR..."
cp "$AAR" "$OUT/wallet-core.aar"

echo "Copying Android proto JAR..."
cp "$PROTO_JAR" "$OUT/wallet-core-proto.jar"

echo "Packaging Swift sources (full Sources/ tree)..."
# Includes top-level (AnySigner.swift, KeyStore.swift, Wallet.swift, etc.) AND
# Generated/ (HDWallet, PrivateKey, Enums/, Protobuf/*) AND Extensions/, Types/.
# Consumers reach into native/ios/Sources/**/*.swift from podspec source_files.
tar -czf "$OUT/swift-sources.tar.gz" -C swift Sources

# Invariant: the tarball MUST contain raw protoc-generated *.pb.swift files.
# Their absence means tools/generate-files ios was run without protoc-gen-swift
# on PATH and only the typealias bridges (+Proto.swift) were produced — every
# TW_<Chain>_Proto_* symbol referenced by chain code is then unresolved at
# consumer build time. v0.2.0/0.2.1 shipped exactly this broken state; never
# again.
echo "Verifying swift-sources tarball contains *.pb.swift..."
PB_COUNT=$(tar -tzf "$OUT/swift-sources.tar.gz" | grep -c '\.pb\.swift$' || true)
if [[ "$PB_COUNT" -lt 1 ]]; then
    echo "ERROR: swift-sources.tar.gz contains 0 *.pb.swift files." >&2
    echo "       Run 'tools/generate-files ios' on a host where protoc-gen-swift" >&2
    echo "       is on PATH (build/local/bin has it), then re-pack." >&2
    exit 3
fi
echo "  OK ($PB_COUNT *.pb.swift entries)"
tar -tzf "$OUT/swift-sources.tar.gz" | grep '\.pb\.swift$' | grep -E '(Ethereum|Solana|Common)\.pb\.swift$' \
    || { echo "ERROR: expected Ethereum.pb.swift / Solana.pb.swift / Common.pb.swift in tarball." >&2; exit 3; }

echo "Computing SHA-256 checksums..."
( cd "$OUT" && shasum -a 256 *.zip *.aar *.jar *.tar.gz > SHA256SUMS )

echo
echo "Release artifacts ready in $OUT:"
ls -lh "$OUT"
echo
echo "Next steps:"
echo "  git tag -a v${VERSION} -m \"v${VERSION}\""
echo "  git push origin v${VERSION}"
echo "  gh release create v${VERSION} --target \$(git rev-parse --abbrev-ref HEAD) \\"
echo "      --title \"v${VERSION}\" --notes-file docs/release-notes/v${VERSION}.md \\"
echo "      ${OUT}/*"
echo "  cd npm-package && npm publish"
