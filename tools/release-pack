#!/bin/bash
#
# Package the built native artifacts into a release directory ready for
# `gh release create` upload.
#
# Usage:
#   tools/release-pack <version>      # e.g. tools/release-pack 0.2.0
#
# Prerequisites (all built ahead of time):
#   - build/ios-frameworks/WalletCoreCommon.xcframework            (tools/ios-build)
#   - swift/WalletCoreRs.xcframework                                (tools/generate-files ios)
#   - build/wallet-core.aar                                         (tools/android-build)
#   - android/wallet-core-proto/build/libs/wallet-core-proto.jar    (./gradlew :wallet-core-proto:jar, from v0.2.0)
#   - swift/Sources/                                                (codegen output, always present)
#
# Output:
#   build/release-v<version>/
#     ├── WalletCoreCommon.xcframework.zip
#     ├── WalletCoreRs.xcframework.zip
#     ├── wallet-core.aar
#     ├── wallet-core-proto.jar          (v0.2.0+: Java protobuf-generated SigningInput types)
#     ├── swift-sources.tar.gz           (v0.2.0+: Swift protobuf + wrapper sources for podspec source_files)
#     └── SHA256SUMS

set -e

VERSION=$1
if [[ -z "$VERSION" ]]; then
    echo "usage: $0 <version>   (e.g. $0 0.2.0)" >&2
    exit 1
fi

OUT="build/release-v${VERSION}"
COMMON_XCF="build/ios-frameworks/WalletCoreCommon.xcframework"
RS_XCF="swift/WalletCoreRs.xcframework"
AAR="build/wallet-core.aar"
PROTO_JAR="android/wallet-core-proto/build/libs/wallet-core-proto.jar"
SWIFT_SRC_DIR="swift/Sources"

for src in "$COMMON_XCF" "$RS_XCF" "$AAR" "$PROTO_JAR" "$SWIFT_SRC_DIR"; do
    if [[ ! -e "$src" ]]; then
        echo "ERROR: required input missing: $src" >&2
        echo "Run the platform builds first (tools/generate-files ios, tools/ios-build," >&2
        echo "tools/android-build, ./gradlew :wallet-core-proto:jar)." >&2
        exit 2
    fi
done

rm -rf "$OUT"
mkdir -p "$OUT"

echo "Staging WalletCoreCommon.xcframework with injected module map + umbrella header..."
# WalletCoreCommon.xcframework as built by tools/ios-build ships pure C
# headers and no Modules/module.modulemap. SwiftPM consumers don't need
# one (the Package.swift target dependency makes the C symbols visible
# inside Swift), but a CocoaPods Swift target cannot see them without a
# module map — every TW* reference in our shipped Swift sources fails
# 'cannot find ... in scope' at SwiftCompile (B6).
#
# We inject the missing pieces into a staged copy before zipping:
#   - <slice>/WalletCoreCommon.framework/Headers/WalletCore.h        (umbrella)
#   - <slice>/WalletCoreCommon.framework/Modules/module.modulemap
# The umbrella header is generated by codegen at swift/Sources/Generated/
# WalletCore.h and #includes every TW*.h transitively.
COMMON_STAGE=$(mktemp -d)
ditto "$COMMON_XCF" "$COMMON_STAGE/WalletCoreCommon.xcframework"
UMBRELLA="swift/Sources/Generated/WalletCore.h"
if [[ ! -f "$UMBRELLA" ]]; then
    echo "ERROR: umbrella header missing: $UMBRELLA" >&2
    echo "       Run 'tools/generate-files ios' first." >&2
    rm -rf "$COMMON_STAGE"
    exit 6
fi
for SLICE_FW in "$COMMON_STAGE/WalletCoreCommon.xcframework"/*/WalletCoreCommon.framework; do
    [[ -d "$SLICE_FW" ]] || continue
    mkdir -p "$SLICE_FW/Headers" "$SLICE_FW/Modules"
    cp "$UMBRELLA" "$SLICE_FW/Headers/WalletCore.h"
    cat > "$SLICE_FW/Modules/module.modulemap" <<'MODMAP'
framework module WalletCoreCommon {
  umbrella header "WalletCore.h"
  export *
  module * { export * }
}
MODMAP
done

echo "Packaging iOS xcframeworks (ditto)..."
ditto -c -k --sequesterRsrc --keepParent "$COMMON_STAGE/WalletCoreCommon.xcframework" "$OUT/WalletCoreCommon.xcframework.zip"
ditto -c -k --sequesterRsrc --keepParent "$RS_XCF"     "$OUT/WalletCoreRs.xcframework.zip"
rm -rf "$COMMON_STAGE"

echo "Copying Android AAR..."
cp "$AAR" "$OUT/wallet-core.aar"

echo "Copying Android proto JAR..."
cp "$PROTO_JAR" "$OUT/wallet-core-proto.jar"

echo "Normalising Swift Protobuf module name (CocoaPods compatibility)..."
# tools/generate-files ios rewrites every Sources/Generated/Protobuf/*.swift
# from `import SwiftProtobuf` to `import WalletCoreSwiftProtobuf` (and the
# qualified-symbol form `SwiftProtobuf.` → `WalletCoreSwiftProtobuf.`) so the
# upstream SwiftPM target can re-export Apple's SwiftProtobuf under its own
# umbrella. CocoaPods consumers (cirqle-mobile, etc.) link against the
# canonical `SwiftProtobuf` pod and have no such alias, so every .pb.swift
# fails to resolve `WalletCoreSwiftProtobuf` at SwiftCompile time. v0.2.0–
# v0.2.3 all shipped this — surfaced only on v0.2.3 once the pb.swift files
# finally reached the pod target's SwiftFileList (B4 fix).
#
# We undo the rewrite in-place here, just before the tarball is produced,
# so downstream pods can compile the Protobuf tree as-is.
# Covers both the generated Protobuf tree AND hand-written wrappers like
# swift/Sources/AnySigner.swift that also `import WalletCoreSwiftProtobuf`.
SWIFT_ROOT="swift/Sources"
if [[ -d "$SWIFT_ROOT" ]]; then
    find "$SWIFT_ROOT" -name '*.swift' -print0 | while IFS= read -r -d '' f; do
        # macOS sed needs `-i ''` (with empty backup suffix); GNU sed accepts `-i`.
        if sed --version >/dev/null 2>&1; then
            SED_INPLACE=(sed -i)
        else
            SED_INPLACE=(sed -i '')
        fi
        "${SED_INPLACE[@]}" \
            -e 's/^import WalletCoreSwiftProtobuf$/import SwiftProtobuf/' \
            -e 's/WalletCoreSwiftProtobuf\./SwiftProtobuf./g' \
            "$f"
    done
fi

echo "Injecting 'import WalletCoreCommon' so Swift sources can see TW* C symbols (CocoaPods)..."
# The Swift wrappers in Sources/ (HDWallet.swift, AnySigner-using files,
# Extensions/*+Extension.swift on TW enums, every TWxxx-using class)
# reference C functions like TWHDWalletCreate / TWStringDelete / etc.
# directly. In SwiftPM consumers these symbols are visible because
# Package.swift declares the C target as a dependency; in CocoaPods
# consumers we need the Swift module to explicitly `import WalletCoreCommon`,
# which the codegen output does not emit. We add the import here so the
# published tarball is CocoaPods-ready.
#
# Only files outside Sources/Generated/Protobuf/ get the import — the
# protobuf-only files don't reference TW* and adding the import would only
# create a no-op dependency.
#
# Inserts after `import Foundation` if present (e.g. HDWallet.swift), or
# before the first non-comment / non-blank line if there's no `import
# Foundation` (e.g. HDVersion+Extension.swift, which is a pure
# `extension` file).
if [[ -d "$SWIFT_ROOT" ]]; then
    find "$SWIFT_ROOT" -name '*.swift' -not -path '*/Protobuf/*' -print0 | while IFS= read -r -d '' f; do
        # Idempotent: skip files already importing WalletCoreCommon.
        if grep -q '^import WalletCoreCommon$' "$f"; then
            continue
        fi
        # Skip files that don't reference any TW symbol — no need for the
        # import.
        if ! grep -qE 'TW[A-Z][A-Za-z]' "$f"; then
            continue
        fi
        # awk-based insert:
        #   - if a line `^import Foundation$` appears, insert
        #     `import WalletCoreCommon` immediately after it
        #   - otherwise, insert before the first line that isn't a `//`
        #     comment and isn't blank
        TMP=$(mktemp)
        awk '
            BEGIN { inserted = 0 }
            /^import Foundation$/ {
                print
                if (!inserted) { print "import WalletCoreCommon"; inserted = 1 }
                next
            }
            inserted == 0 && !/^\/\// && !/^[[:space:]]*$/ {
                print "import WalletCoreCommon"
                print ""
                inserted = 1
            }
            { print }
        ' "$f" > "$TMP" && mv "$TMP" "$f"
    done
fi

echo "Stripping Swift wrappers that reference TW symbols not present in shipped C headers..."
# Some upstream codegen Swift files reference TW functions that were
# removed (or never declared) in the C ABI we ship via the xcframework.
# Compiling them under CocoaPods then fails with 'cannot find TWxxx in
# scope' even though the file imports WalletCoreCommon — the symbol
# really isn't there. We remove those files from the tarball entirely.
#
# Current known set:
#   - Sources/Generated/CryptoBoxSecretKey.swift
#     (references TWCryptoBoxSecretKeyGetPublicKey; TWCryptoBoxSecretKey.h
#      only declares TWCryptoBoxSecretKeyData)
#
# When a new mismatch surfaces, add the path here, re-tag, and document
# the symbol delta in the release notes.
SWIFT_SKIP=(
    # CryptoBox family — Swift wrappers reference TW symbols not declared
    # in the shipped C headers (only TWCryptoBoxSecretKeyData is exported,
    # not GetPublicKey / IsValid / CreateWithData / Delete). Stripping the
    # secret-key file forces stripping its dependents (CryptoBox.swift uses
    # CryptoBoxSecretKey; CryptoBoxPublicKey.swift has its own missing
    # symbols). Whole family unused by EVM/Solana signing.
    "Sources/Generated/CryptoBox.swift"
    "Sources/Generated/CryptoBoxPublicKey.swift"
    "Sources/Generated/CryptoBoxSecretKey.swift"
)

echo "Packaging Swift sources (full Sources/ tree)..."
# Includes top-level (AnySigner.swift, KeyStore.swift, Wallet.swift, etc.) AND
# Generated/ (HDWallet, PrivateKey, Enums/, Protobuf/*) AND Extensions/, Types/.
# Consumers reach into <pkg>/ios/Sources/**/*.swift via the podspec
# source_files glob (v0.2.3+ layout: postinstall extracts Sources/ inside
# the podspec dir; earlier versions used `../native/ios/Sources/` which
# CocoaPods silently drops on `..`-traversal).
TAR_EXCLUDE_ARGS=()
for skip in "${SWIFT_SKIP[@]}"; do
    TAR_EXCLUDE_ARGS+=(--exclude "$skip")
done
tar -czf "$OUT/swift-sources.tar.gz" "${TAR_EXCLUDE_ARGS[@]}" -C swift Sources

# Invariant: the tarball MUST contain raw protoc-generated *.pb.swift files.
# Their absence means tools/generate-files ios was run without protoc-gen-swift
# on PATH and only the typealias bridges (+Proto.swift) were produced — every
# TW_<Chain>_Proto_* symbol referenced by chain code is then unresolved at
# consumer build time. v0.2.0/0.2.1 shipped exactly this broken state; never
# again.
echo "Verifying swift-sources tarball contains *.pb.swift..."
PB_COUNT=$(tar -tzf "$OUT/swift-sources.tar.gz" | grep -c '\.pb\.swift$' || true)
if [[ "$PB_COUNT" -lt 1 ]]; then
    echo "ERROR: swift-sources.tar.gz contains 0 *.pb.swift files." >&2
    echo "       Run 'tools/generate-files ios' on a host where protoc-gen-swift" >&2
    echo "       is on PATH (build/local/bin has it), then re-pack." >&2
    exit 3
fi
echo "  OK ($PB_COUNT *.pb.swift entries)"
tar -tzf "$OUT/swift-sources.tar.gz" | grep '\.pb\.swift$' | grep -E '(Ethereum|Solana|Common)\.pb\.swift$' \
    || { echo "ERROR: expected Ethereum.pb.swift / Solana.pb.swift / Common.pb.swift in tarball." >&2; exit 3; }

# Invariant: every protobuf source must import the CocoaPods-visible
# `SwiftProtobuf` module, never the SwiftPM-only `WalletCoreSwiftProtobuf`
# alias. The sed pass above is supposed to convert; this check guarantees
# it. (v0.2.4+: paired with the .pb.swift count guard from v0.2.2 and the
# Ethereum/Solana/Common presence check.)
echo "Verifying no WalletCoreSwiftProtobuf references survive..."
TMP_EXTRACT=$(mktemp -d)
tar -xzf "$OUT/swift-sources.tar.gz" -C "$TMP_EXTRACT"
LEAKED=$(grep -rl "WalletCoreSwiftProtobuf" "$TMP_EXTRACT" 2>/dev/null | wc -l | tr -d ' ')
if [[ "$LEAKED" -gt 0 ]]; then
    echo "ERROR: $LEAKED file(s) in swift-sources.tar.gz still reference 'WalletCoreSwiftProtobuf'." >&2
    echo "       The sed normalisation step should have rewritten them to 'SwiftProtobuf'." >&2
    rm -rf "$TMP_EXTRACT"
    exit 4
fi
echo "  OK (0 WalletCoreSwiftProtobuf references)"

# Invariant (v0.2.5+): every non-Protobuf Swift source that references a
# TW symbol must `import WalletCoreCommon`. Without this, the TW* reference
# fails 'cannot find ... in scope' under CocoaPods. v0.2.8 expanded the
# rule from 'files with import Foundation' to 'files with any TW symbol',
# which catches pure-extension files like HDVersion+Extension.swift that
# omit the Foundation import.
echo "Verifying every TW-using Swift file imports WalletCoreCommon..."
MISSING_IMPORT=$(find "$TMP_EXTRACT" -name '*.swift' -not -path '*/Protobuf/*' \
    -exec sh -c 'grep -qE "TW[A-Z][A-Za-z]" "$1" && ! grep -q "^import WalletCoreCommon$" "$1" && echo "$1"' _ {} \; 2>/dev/null | wc -l | tr -d ' ')
if [[ "$MISSING_IMPORT" -gt 0 ]]; then
    echo "ERROR: $MISSING_IMPORT TW-using Swift file(s) missing 'import WalletCoreCommon' after sed pass." >&2
    rm -rf "$TMP_EXTRACT"
    exit 7
fi
echo "  OK (all TW-using .swift files import WalletCoreCommon)"

# Invariant (v0.2.5+): WalletCoreCommon.xcframework includes Modules/module.modulemap.
echo "Verifying WalletCoreCommon.xcframework has Modules/module.modulemap..."
TMP_FW=$(mktemp -d)
ditto -x -k "$OUT/WalletCoreCommon.xcframework.zip" "$TMP_FW"
MODMAP_COUNT=$(find "$TMP_FW" -path "*/WalletCoreCommon.framework/Modules/module.modulemap" 2>/dev/null | wc -l | tr -d ' ')
UMBRELLA_COUNT=$(find "$TMP_FW" -path "*/WalletCoreCommon.framework/Headers/WalletCore.h" 2>/dev/null | wc -l | tr -d ' ')
rm -rf "$TMP_FW" "$TMP_EXTRACT"
# Expect one per slice (4 slices: ios-arm64, ios-arm64_x86_64-simulator,
# ios-arm64_x86_64-maccatalyst, macos-arm64_x86_64).
if [[ "$MODMAP_COUNT" -lt 1 || "$UMBRELLA_COUNT" -lt 1 ]]; then
    echo "ERROR: WalletCoreCommon.xcframework slices missing module.modulemap / WalletCore.h (modmaps=$MODMAP_COUNT umbrellas=$UMBRELLA_COUNT)." >&2
    exit 8
fi
echo "  OK ($MODMAP_COUNT slice(s) with module.modulemap, $UMBRELLA_COUNT umbrella header(s))"

# Invariant (v0.2.15+): the Expo Module Kotlin wrapper that consumers
# autolink MUST call System.loadLibrary("TrustWalletCore") somewhere
# (companion init, static block, init {} body, or via a load-helper
# call). Without it, every wallet.core.jni.* call from JS throws
# UnsatisfiedLinkError at runtime — the .so is in the APK but the
# JVM never loaded it. wallet-core.aar itself ships zero classes
# that call loadLibrary (verified with `javap -c` across classes.jar),
# so the responsibility falls on the Expo Module wrapper. Stage B
# (compile) cannot catch this; only Stage D (runtime) does.
# This is the Android counterpart of the iOS pack-time guards above.
echo "Verifying WalletCoreModule.kt loads the TrustWalletCore .so..."
WC_MODULE_KT="npm-package/android/src/main/java/expo/modules/walletcore/WalletCoreModule.kt"
if [[ ! -f "$WC_MODULE_KT" ]]; then
    echo "ERROR: $WC_MODULE_KT not found — release-pack invariant cannot run." >&2
    exit 10
fi
if ! grep -qE 'System\.loadLibrary\([^)]*"TrustWalletCore"' "$WC_MODULE_KT"; then
    echo "ERROR: $WC_MODULE_KT does not call System.loadLibrary(\"TrustWalletCore\")." >&2
    echo "       Add a companion-object init { System.loadLibrary(\"TrustWalletCore\") }" >&2
    echo "       block — without it consumer JS calls throw UnsatisfiedLinkError at" >&2
    echo "       runtime even though the .so is bundled (the JVM never loads it)." >&2
    exit 10
fi
echo "  OK (System.loadLibrary call present)"

# Invariant (v0.2.17+): npm-package/android/build.gradle must not declare a
# direct local .aar file dep. AGP 8.x runs `:<module>:bundleDebugAar` on every
# android-library module and rejects local AAR deps via `hasLocalAarDeps`,
# blocking consumer `:app:assembleDebug` builds (B11 — surfaced during cirqle
# PR 5a-2 Stage B). Consume `wallet-core-classes.jar` + `jniLibs/` instead;
# both are produced by the postinstall unpack step (also guarded below).
echo "Verifying android/build.gradle does not reference wallet-core.aar as a file dep..."
WC_BUILD_GRADLE="npm-package/android/build.gradle"
if [[ ! -f "$WC_BUILD_GRADLE" ]]; then
    echo "ERROR: $WC_BUILD_GRADLE not found — release-pack invariant cannot run." >&2
    exit 11
fi
if grep -E 'implementation[[:space:]]+files\([^)]*wallet-core\.aar' "$WC_BUILD_GRADLE" >/dev/null; then
    echo "ERROR: $WC_BUILD_GRADLE still references wallet-core.aar as a local file dep." >&2
    echo "       AGP 8.x rejects this on bundleDebugAar (hasLocalAarDeps). Consume" >&2
    echo "       wallet-core-classes.jar + jniLibs.srcDirs instead (v0.2.17 pattern)." >&2
    exit 11
fi
if ! grep -E 'implementation[[:space:]]+files\([^)]*wallet-core-classes\.jar' "$WC_BUILD_GRADLE" >/dev/null; then
    echo "ERROR: $WC_BUILD_GRADLE does not declare wallet-core-classes.jar dep." >&2
    echo "       v0.2.17+ expects implementation files(\"\${nativeAndroidDir}/wallet-core-classes.jar\")." >&2
    exit 11
fi
if ! grep -E 'jniLibs\.srcDirs[[:space:]]*\+?=[[:space:]]*\[[^]]*jniLibs' "$WC_BUILD_GRADLE" >/dev/null; then
    echo "ERROR: $WC_BUILD_GRADLE does not extend jniLibs.srcDirs with the unpacked jniLibs/ dir." >&2
    echo "       Without it the .so libs from wallet-core.aar never reach the merged APK." >&2
    exit 11
fi
echo "  OK (build.gradle on JAR + jniLibs.srcDirs pattern)"

# Invariant (v0.2.17+): npm-package/postinstall.js must perform the AAR
# unpack step. Without it the published build.gradle references files that
# don't exist on the consumer's disk.
echo "Verifying postinstall.js unpacks wallet-core.aar..."
WC_POSTINSTALL="npm-package/postinstall.js"
if [[ ! -f "$WC_POSTINSTALL" ]]; then
    echo "ERROR: $WC_POSTINSTALL not found — release-pack invariant cannot run." >&2
    exit 12
fi
if ! grep -E "wallet-core-classes\.jar" "$WC_POSTINSTALL" >/dev/null; then
    echo "ERROR: $WC_POSTINSTALL unpack block does not emit wallet-core-classes.jar." >&2
    echo "       v0.2.17+ expects a postinstall block that splits wallet-core.aar" >&2
    echo "       into wallet-core-classes.jar + jniLibs/<ABI>/libTrustWalletCore.so." >&2
    exit 12
fi
if ! grep -E "jniLibs" "$WC_POSTINSTALL" >/dev/null; then
    echo "ERROR: $WC_POSTINSTALL unpack block does not lay out jniLibs/." >&2
    echo "       Without jniLibs the .so files never reach the merged APK." >&2
    exit 12
fi
if ! grep -E "execFileSync\(['\"]unzip['\"]" "$WC_POSTINSTALL" >/dev/null; then
    echo "ERROR: $WC_POSTINSTALL does not invoke unzip (the AAR split needs it)." >&2
    exit 12
fi
echo "  OK (postinstall has AAR unpack → classes.jar + jniLibs/)"

# Invariant (v0.2.18+): `def nativeAndroidDir` MUST be declared before the
# `android { ... }` block. AGP evaluates the closure eagerly during the
# configuration phase, and `sourceSets.main.jniLibs.srcDirs +=
# ["${nativeAndroidDir}/..."]` reads from script-scope at that moment. If the
# `def` lives below the closure, fresh consumer installs fail with
# `MissingPropertyException: nativeAndroidDir`, cascading to
# `SoftwareComponent with name 'release' not found` from
# expo-module-gradle-plugin's `applyPublishing` (red herring — the second
# error obscures the first). v0.2.17 shipped this exact regression.
echo "Verifying def nativeAndroidDir precedes the android { ... } block..."
DEF_LINE=$(grep -n '^def nativeAndroidDir\b' "$WC_BUILD_GRADLE" | head -1 | cut -d: -f1)
ANDROID_LINE=$(grep -n '^android[[:space:]]*{' "$WC_BUILD_GRADLE" | head -1 | cut -d: -f1)
# Skip lines whose first non-whitespace chars are `//` so the doc comment
# above the def (which contains an explanatory example matching the same
# pattern) doesn't get mistaken for an actual reference site.
JNI_REF_LINE=$(awk '
    !/^[[:space:]]*\/\// && /jniLibs\.srcDirs.*nativeAndroidDir/ { print NR; exit }
' "$WC_BUILD_GRADLE")
if [[ -z "$DEF_LINE" ]]; then
    echo "ERROR: $WC_BUILD_GRADLE has no 'def nativeAndroidDir' declaration." >&2
    exit 13
fi
if [[ -z "$ANDROID_LINE" ]]; then
    echo "ERROR: $WC_BUILD_GRADLE has no 'android { ... }' block." >&2
    exit 13
fi
if [[ -n "$JNI_REF_LINE" && "$DEF_LINE" -gt "$JNI_REF_LINE" ]]; then
    echo "ERROR: $WC_BUILD_GRADLE declares 'def nativeAndroidDir' at line $DEF_LINE," >&2
    echo "       AFTER its reference inside jniLibs.srcDirs at line $JNI_REF_LINE." >&2
    echo "       AGP evaluates android { ... } eagerly; the var must be defined first." >&2
    echo "       Move 'def nativeAndroidDir = ...' above the android { ... } block." >&2
    exit 13
fi
if [[ "$DEF_LINE" -gt "$ANDROID_LINE" ]]; then
    echo "ERROR: $WC_BUILD_GRADLE declares 'def nativeAndroidDir' at line $DEF_LINE," >&2
    echo "       AFTER the android { ... } block starts at line $ANDROID_LINE." >&2
    echo "       Convention: every script-scope def lives above the android { } block." >&2
    exit 13
fi
echo "  OK (def at line $DEF_LINE, android { } at line $ANDROID_LINE, jniLibs ref at line ${JNI_REF_LINE:-n/a})"

echo "Computing SHA-256 checksums..."
( cd "$OUT" && shasum -a 256 *.zip *.aar *.jar *.tar.gz > SHA256SUMS )

# Invariant (v0.3.0+ — audit W-01): the SHA256SUMS that postinstall.js will
# verify downloaded assets against must be EMBEDDED in the npm tarball, not
# fetched from the same BASE_URL as the assets themselves. Without this,
# `WALLET_CORE_RELEASE_BASE_URL` override (or a compromised release host)
# could swap binaries and the matching checksums together, defeating the
# integrity check entirely. The embedded pin is the single source of truth;
# the remote SHA256SUMS is no longer downloaded by postinstall.
echo "Embedding SHA256SUMS pin into npm-package/native-pins/ (W-01)..."
PIN_DIR="npm-package/native-pins"
mkdir -p "$PIN_DIR"
cp "$OUT/SHA256SUMS" "$PIN_DIR/SHA256SUMS"
PIN_ENTRIES=$(wc -l < "$PIN_DIR/SHA256SUMS" | tr -d ' ')
if [[ "$PIN_ENTRIES" -lt 5 ]]; then
    echo "ERROR: $PIN_DIR/SHA256SUMS has $PIN_ENTRIES entries (expected ≥5: xcfw × 2, aar, proto.jar, swift-sources)." >&2
    exit 14
fi
echo "  OK (embedded pin: $PIN_DIR/SHA256SUMS, $PIN_ENTRIES entries)"

# Invariant (v0.3.0+): postinstall.js must load the embedded pin and refuse
# to fall back to a remote SHA256SUMS download. Two checks:
#   1. It reads npm-package/native-pins/SHA256SUMS from the package tree.
#   2. It does NOT call downloadString on `${BASE_URL}/${SUMS_FILE}` — that
#      pattern is the v0.2.x self-referential checksum download we're
#      retiring.
echo "Verifying postinstall.js loads the embedded pin + does not download remote SHA256SUMS..."
if ! grep -E "native-pins[/'\"]+SHA256SUMS" "$WC_POSTINSTALL" >/dev/null; then
    echo "ERROR: $WC_POSTINSTALL does not reference native-pins/SHA256SUMS." >&2
    echo "       v0.3.0+ requires loading the embedded pin shipped in the npm tarball" >&2
    echo "       instead of downloading the SHA256SUMS file from the release host." >&2
    exit 14
fi
if grep -E "downloadString\([^)]*SUMS_FILE" "$WC_POSTINSTALL" >/dev/null; then
    echo "ERROR: $WC_POSTINSTALL still calls downloadString(BASE_URL + SUMS_FILE)." >&2
    echo "       Remote SHA256SUMS download is W-01's attack surface — drop it." >&2
    exit 14
fi
echo "  OK (postinstall pins against embedded SHA256SUMS, no remote SUMS fetch)"

# Invariant (v0.3.0+): package.json `files:` allowlist must include
# `native-pins` so the embedded SHA256SUMS reaches the consumer's tarball.
echo "Verifying package.json files allowlist includes native-pins..."
WC_PKG_JSON="npm-package/package.json"
if ! node -e '
    const f = require("./" + process.argv[1]).files || [];
    if (!f.includes("native-pins")) {
        console.error("files allowlist missing native-pins");
        process.exit(1);
    }
' "$WC_PKG_JSON" 2>&1; then
    echo "ERROR: $WC_PKG_JSON files allowlist does not include 'native-pins'." >&2
    echo "       Without it, npm publish drops native-pins/SHA256SUMS from the tarball" >&2
    echo "       and consumer postinstall fails W-01 pinning." >&2
    exit 14
fi
echo "  OK (package.json files allowlist includes native-pins)"

echo
echo "Release artifacts ready in $OUT:"
ls -lh "$OUT"
echo
echo "Next steps:"
echo "  git tag -a v${VERSION} -m \"v${VERSION}\""
