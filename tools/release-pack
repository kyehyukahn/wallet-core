#!/bin/bash
#
# Package the built native artifacts into a release directory ready for
# `gh release create` upload.
#
# Usage:
#   tools/release-pack <version>      # e.g. tools/release-pack 0.2.0
#
# Prerequisites (all built ahead of time):
#   - build/ios-frameworks/WalletCoreCommon.xcframework            (tools/ios-build)
#   - swift/WalletCoreRs.xcframework                                (tools/generate-files ios)
#   - build/wallet-core.aar                                         (tools/android-build)
#   - android/wallet-core-proto/build/libs/wallet-core-proto.jar    (./gradlew :wallet-core-proto:jar, from v0.2.0)
#   - swift/Sources/                                                (codegen output, always present)
#
# Output:
#   build/release-v<version>/
#     ├── WalletCoreCommon.xcframework.zip
#     ├── WalletCoreRs.xcframework.zip
#     ├── wallet-core.aar
#     ├── wallet-core-proto.jar          (v0.2.0+: Java protobuf-generated SigningInput types)
#     ├── swift-sources.tar.gz           (v0.2.0+: Swift protobuf + wrapper sources for podspec source_files)
#     └── SHA256SUMS

set -e

VERSION=$1
if [[ -z "$VERSION" ]]; then
    echo "usage: $0 <version>   (e.g. $0 0.2.0)" >&2
    exit 1
fi

OUT="build/release-v${VERSION}"
COMMON_XCF="build/ios-frameworks/WalletCoreCommon.xcframework"
RS_XCF="swift/WalletCoreRs.xcframework"
AAR="build/wallet-core.aar"
PROTO_JAR="android/wallet-core-proto/build/libs/wallet-core-proto.jar"
SWIFT_SRC_DIR="swift/Sources"

for src in "$COMMON_XCF" "$RS_XCF" "$AAR" "$PROTO_JAR" "$SWIFT_SRC_DIR"; do
    if [[ ! -e "$src" ]]; then
        echo "ERROR: required input missing: $src" >&2
        echo "Run the platform builds first (tools/generate-files ios, tools/ios-build," >&2
        echo "tools/android-build, ./gradlew :wallet-core-proto:jar)." >&2
        exit 2
    fi
done

rm -rf "$OUT"
mkdir -p "$OUT"

echo "Staging WalletCoreCommon.xcframework with injected module map + umbrella header..."
# WalletCoreCommon.xcframework as built by tools/ios-build ships pure C
# headers and no Modules/module.modulemap. SwiftPM consumers don't need
# one (the Package.swift target dependency makes the C symbols visible
# inside Swift), but a CocoaPods Swift target cannot see them without a
# module map — every TW* reference in our shipped Swift sources fails
# 'cannot find ... in scope' at SwiftCompile (B6).
#
# We inject the missing pieces into a staged copy before zipping:
#   - <slice>/WalletCoreCommon.framework/Headers/WalletCore.h        (umbrella)
#   - <slice>/WalletCoreCommon.framework/Modules/module.modulemap
# The umbrella header is generated by codegen at swift/Sources/Generated/
# WalletCore.h and #includes every TW*.h transitively.
COMMON_STAGE=$(mktemp -d)
ditto "$COMMON_XCF" "$COMMON_STAGE/WalletCoreCommon.xcframework"
UMBRELLA="swift/Sources/Generated/WalletCore.h"
if [[ ! -f "$UMBRELLA" ]]; then
    echo "ERROR: umbrella header missing: $UMBRELLA" >&2
    echo "       Run 'tools/generate-files ios' first." >&2
    rm -rf "$COMMON_STAGE"
    exit 6
fi
for SLICE_FW in "$COMMON_STAGE/WalletCoreCommon.xcframework"/*/WalletCoreCommon.framework; do
    [[ -d "$SLICE_FW" ]] || continue
    mkdir -p "$SLICE_FW/Headers" "$SLICE_FW/Modules"
    cp "$UMBRELLA" "$SLICE_FW/Headers/WalletCore.h"
    cat > "$SLICE_FW/Modules/module.modulemap" <<'MODMAP'
framework module WalletCoreCommon {
  umbrella header "WalletCore.h"
  export *
  module * { export * }
}
MODMAP
done

echo "Packaging iOS xcframeworks (ditto)..."
ditto -c -k --sequesterRsrc --keepParent "$COMMON_STAGE/WalletCoreCommon.xcframework" "$OUT/WalletCoreCommon.xcframework.zip"
ditto -c -k --sequesterRsrc --keepParent "$RS_XCF"     "$OUT/WalletCoreRs.xcframework.zip"
rm -rf "$COMMON_STAGE"

echo "Copying Android AAR..."
cp "$AAR" "$OUT/wallet-core.aar"

echo "Copying Android proto JAR..."
cp "$PROTO_JAR" "$OUT/wallet-core-proto.jar"

echo "Normalising Swift Protobuf module name (CocoaPods compatibility)..."
# tools/generate-files ios rewrites every Sources/Generated/Protobuf/*.swift
# from `import SwiftProtobuf` to `import WalletCoreSwiftProtobuf` (and the
# qualified-symbol form `SwiftProtobuf.` → `WalletCoreSwiftProtobuf.`) so the
# upstream SwiftPM target can re-export Apple's SwiftProtobuf under its own
# umbrella. CocoaPods consumers (cirqle-mobile, etc.) link against the
# canonical `SwiftProtobuf` pod and have no such alias, so every .pb.swift
# fails to resolve `WalletCoreSwiftProtobuf` at SwiftCompile time. v0.2.0–
# v0.2.3 all shipped this — surfaced only on v0.2.3 once the pb.swift files
# finally reached the pod target's SwiftFileList (B4 fix).
#
# We undo the rewrite in-place here, just before the tarball is produced,
# so downstream pods can compile the Protobuf tree as-is.
# Covers both the generated Protobuf tree AND hand-written wrappers like
# swift/Sources/AnySigner.swift that also `import WalletCoreSwiftProtobuf`.
SWIFT_ROOT="swift/Sources"
if [[ -d "$SWIFT_ROOT" ]]; then
    find "$SWIFT_ROOT" -name '*.swift' -print0 | while IFS= read -r -d '' f; do
        # macOS sed needs `-i ''` (with empty backup suffix); GNU sed accepts `-i`.
        if sed --version >/dev/null 2>&1; then
            SED_INPLACE=(sed -i)
        else
            SED_INPLACE=(sed -i '')
        fi
        "${SED_INPLACE[@]}" \
            -e 's/^import WalletCoreSwiftProtobuf$/import SwiftProtobuf/' \
            -e 's/WalletCoreSwiftProtobuf\./SwiftProtobuf./g' \
            "$f"
    done
fi

echo "Injecting 'import WalletCoreCommon' so Swift sources can see TW* C symbols (CocoaPods)..."
# The Swift wrappers in Sources/Generated/ (HDWallet.swift, AnySigner-using
# files, every TWxxx-using class) reference C functions like
# TWHDWalletCreate / TWStringDelete / etc. directly. In SwiftPM consumers
# these symbols are visible because Package.swift declares the C target
# as a dependency; in CocoaPods consumers we need the Swift module to
# explicitly `import WalletCoreCommon`, which the codegen output does not
# emit. We add the import here so the published tarball is CocoaPods-ready.
#
# Only files outside Sources/Generated/Protobuf/ get the import: the
# protobuf-only files don't reference TW* and adding the import would only
# create a no-op dependency.
if [[ -d "$SWIFT_ROOT" ]]; then
    find "$SWIFT_ROOT" -name '*.swift' -not -path '*/Protobuf/*' -print0 | while IFS= read -r -d '' f; do
        # Skip if already imports WalletCoreCommon (idempotent).
        if grep -q '^import WalletCoreCommon$' "$f"; then
            continue
        fi
        # Skip files that don't `import Foundation` either (they're not
        # standalone Swift sources — Dummy.cpp / SecRandom.m / etc. won't
        # match the *.swift glob, but be defensive).
        if ! grep -q '^import Foundation$' "$f"; then
            continue
        fi
        if sed --version >/dev/null 2>&1; then
            sed -i \
                -e '/^import Foundation$/a\
import WalletCoreCommon' "$f"
        else
            # BSD sed wants the `a\` continuation on its own line.
            sed -i '' -e $'/^import Foundation$/a\\\nimport WalletCoreCommon' "$f"
        fi
    done
fi

echo "Packaging Swift sources (full Sources/ tree)..."
# Includes top-level (AnySigner.swift, KeyStore.swift, Wallet.swift, etc.) AND
# Generated/ (HDWallet, PrivateKey, Enums/, Protobuf/*) AND Extensions/, Types/.
# Consumers reach into <pkg>/ios/Sources/**/*.swift via the podspec
# source_files glob (v0.2.3+ layout: postinstall extracts Sources/ inside
# the podspec dir; earlier versions used `../native/ios/Sources/` which
# CocoaPods silently drops on `..`-traversal).
tar -czf "$OUT/swift-sources.tar.gz" -C swift Sources

# Invariant: the tarball MUST contain raw protoc-generated *.pb.swift files.
# Their absence means tools/generate-files ios was run without protoc-gen-swift
# on PATH and only the typealias bridges (+Proto.swift) were produced — every
# TW_<Chain>_Proto_* symbol referenced by chain code is then unresolved at
# consumer build time. v0.2.0/0.2.1 shipped exactly this broken state; never
# again.
echo "Verifying swift-sources tarball contains *.pb.swift..."
PB_COUNT=$(tar -tzf "$OUT/swift-sources.tar.gz" | grep -c '\.pb\.swift$' || true)
if [[ "$PB_COUNT" -lt 1 ]]; then
    echo "ERROR: swift-sources.tar.gz contains 0 *.pb.swift files." >&2
    echo "       Run 'tools/generate-files ios' on a host where protoc-gen-swift" >&2
    echo "       is on PATH (build/local/bin has it), then re-pack." >&2
    exit 3
fi
echo "  OK ($PB_COUNT *.pb.swift entries)"
tar -tzf "$OUT/swift-sources.tar.gz" | grep '\.pb\.swift$' | grep -E '(Ethereum|Solana|Common)\.pb\.swift$' \
    || { echo "ERROR: expected Ethereum.pb.swift / Solana.pb.swift / Common.pb.swift in tarball." >&2; exit 3; }

# Invariant: every protobuf source must import the CocoaPods-visible
# `SwiftProtobuf` module, never the SwiftPM-only `WalletCoreSwiftProtobuf`
# alias. The sed pass above is supposed to convert; this check guarantees
# it. (v0.2.4+: paired with the .pb.swift count guard from v0.2.2 and the
# Ethereum/Solana/Common presence check.)
echo "Verifying no WalletCoreSwiftProtobuf references survive..."
TMP_EXTRACT=$(mktemp -d)
tar -xzf "$OUT/swift-sources.tar.gz" -C "$TMP_EXTRACT"
LEAKED=$(grep -rl "WalletCoreSwiftProtobuf" "$TMP_EXTRACT" 2>/dev/null | wc -l | tr -d ' ')
if [[ "$LEAKED" -gt 0 ]]; then
    echo "ERROR: $LEAKED file(s) in swift-sources.tar.gz still reference 'WalletCoreSwiftProtobuf'." >&2
    echo "       The sed normalisation step should have rewritten them to 'SwiftProtobuf'." >&2
    rm -rf "$TMP_EXTRACT"
    exit 4
fi
echo "  OK (0 WalletCoreSwiftProtobuf references)"

# Invariant (v0.2.5+): non-Protobuf Swift sources must `import WalletCoreCommon`.
# Without this, every TW* reference fails 'cannot find ... in scope' under
# CocoaPods (the xcframework's C symbols aren't visible to the Swift module
# unless the source explicitly imports the framework module).
echo "Verifying non-Protobuf Swift files import WalletCoreCommon..."
MISSING_IMPORT=$(find "$TMP_EXTRACT" -name '*.swift' -not -path '*/Protobuf/*' \
    -exec sh -c 'grep -q "^import Foundation$" "$1" && ! grep -q "^import WalletCoreCommon$" "$1" && echo "$1"' _ {} \; 2>/dev/null | wc -l | tr -d ' ')
if [[ "$MISSING_IMPORT" -gt 0 ]]; then
    echo "ERROR: $MISSING_IMPORT non-Protobuf Swift file(s) missing 'import WalletCoreCommon' after sed pass." >&2
    rm -rf "$TMP_EXTRACT"
    exit 7
fi
echo "  OK (all non-Protobuf .swift files import WalletCoreCommon)"

# Invariant (v0.2.5+): WalletCoreCommon.xcframework includes Modules/module.modulemap.
echo "Verifying WalletCoreCommon.xcframework has Modules/module.modulemap..."
TMP_FW=$(mktemp -d)
ditto -x -k "$OUT/WalletCoreCommon.xcframework.zip" "$TMP_FW"
MODMAP_COUNT=$(find "$TMP_FW" -path "*/WalletCoreCommon.framework/Modules/module.modulemap" 2>/dev/null | wc -l | tr -d ' ')
UMBRELLA_COUNT=$(find "$TMP_FW" -path "*/WalletCoreCommon.framework/Headers/WalletCore.h" 2>/dev/null | wc -l | tr -d ' ')
rm -rf "$TMP_FW" "$TMP_EXTRACT"
# Expect one per slice (4 slices: ios-arm64, ios-arm64_x86_64-simulator,
# ios-arm64_x86_64-maccatalyst, macos-arm64_x86_64).
if [[ "$MODMAP_COUNT" -lt 1 || "$UMBRELLA_COUNT" -lt 1 ]]; then
    echo "ERROR: WalletCoreCommon.xcframework slices missing module.modulemap / WalletCore.h (modmaps=$MODMAP_COUNT umbrellas=$UMBRELLA_COUNT)." >&2
    exit 8
fi
echo "  OK ($MODMAP_COUNT slice(s) with module.modulemap, $UMBRELLA_COUNT umbrella header(s))"

echo "Computing SHA-256 checksums..."
( cd "$OUT" && shasum -a 256 *.zip *.aar *.jar *.tar.gz > SHA256SUMS )

echo
echo "Release artifacts ready in $OUT:"
ls -lh "$OUT"
echo
echo "Next steps:"
echo "  git tag -a v${VERSION} -m \"v${VERSION}\""
echo "  git push origin v${VERSION}"
echo "  gh release create v${VERSION} --target \$(git rev-parse --abbrev-ref HEAD) \\"
echo "      --title \"v${VERSION}\" --notes-file docs/release-notes/v${VERSION}.md \\"
echo "      ${OUT}/*"
echo "  cd npm-package && npm publish"
