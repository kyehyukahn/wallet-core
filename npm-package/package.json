{
  "name": "@kyehyukahn/wallet-core",
  "version": "0.2.14",
  "description": "Native wallet-core for React Native / Expo: bundles the kyehyukahn/wallet-core fork's iOS xcframeworks + Android AAR + Swift sources + Java protobuf jar, plus a self-contained Expo Module with chain-agnostic TS API and per-chain subpaths (EVM, Solana).",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./evm": {
      "types": "./dist/evm/index.d.ts",
      "default": "./dist/evm/index.js"
    },
    "./solana": {
      "types": "./dist/solana/index.d.ts",
      "default": "./dist/solana/index.js"
    },
    "./expo-module.config.json": "./expo-module.config.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "postinstall": "node postinstall.js"
  },
  "files": [
    "dist",
    "ios",
    "android",
    "expo-module.config.json",
    "postinstall.js",
    "README.md"
  ],
  "keywords": [
    "wallet-core",
    "trustwallet",
    "expo-module",
    "react-native",
    "ios",
    "android",
    "ethereum",
    "solana",
    "evm",
    "hdwallet",
    "bip39",
    "bip44"
  ],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "expo": ">=51",
    "expo-modules-core": "*",
    "react-native": ">=0.74"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kyehyukahn/wallet-core.git",
    "directory": "npm-package"
  },
  "license": "MIT"
}
